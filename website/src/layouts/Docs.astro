---
import LeftSidebar from "../components/page/Docs/LeftSidebar.astro";
import "../styles/global.css";
const { title = "sculk-cli docs" } = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>
    </head>
    <body class="page">
        <div class="flex flex-row gap-2 min-h-screen">
            <LeftSidebar />
            <slot />
        </div>
    </body>
</html>
