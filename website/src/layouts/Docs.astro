---
import LeftSidebarContent from "../components/page/Docs/LeftSidebarContent.astro";
import LeftSidebarMain from "../components/page/Docs/LeftSidebarMain.svelte";
import RightSidebar from "../components/page/Docs/RightSidebar.astro";
import Navbar from "../components/page/Docs/Navbar.svelte";
import "../styles/global.css";
const { title = "sculk-cli docs" } = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>
    </head>
    
    <body class="page">
        <div class="flex flex-row gap-2 min-h-screen">
            <LeftSidebarMain client:load transition:persist>
                <LeftSidebarContent />
            </LeftSidebarMain>
            <div class="flex flex-col flex-1 min-w-0">
                <Navbar client:load />
                <div class="flex min-w-0">
                    <div class="flex-1 min-w-0">
                        <slot />
                    </div>
                    <RightSidebar />
                </div>
            </div>
        </div>
    </body>
</html>
