---
import Layout from '../../layouts/Docs.astro'
import { ClientRouter } from 'astro:transitions';

import { getCollection, getEntry, render } from "astro:content"
import type { CollectionEntry } from "astro:content";

export async function getStaticPaths() {
    const allDocs = await getCollection("docs");
    const mapped = allDocs
        .map((document: CollectionEntry<"docs">) => ({
        params: {doc: document.id}
    }))
    return mapped
}

const { doc } = Astro.params;
const docContent = await getEntry("docs", doc)
const { Content } = await render(docContent!)

const title = `${(docContent?.data.title)} | sculk-docs` || "sculk-docs"
---

<Layout title={title}>
    <div class="doc-format flex flex-col p-10 gap-5">
        <div class="content">
            <Content />
        </div>
    </div>
</Layout>
<ClientRouter />